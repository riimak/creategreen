# BIOS / Mars2 API credentials
# Copy this file to .env and fill in your values:
#   cp .env.example .env
BIOS_API_BASE="http://web.mars2.barrage.net:81"
BIOS_USERNAME=""
BIOS_PASSWORD=""

# BIOS Multi-level Platform - Prediction Analysis Service
PREDICTION_PORT=8091
PREDICTION_DATA_API_BASE=""
PREDICTION_DB_PATH="bios-multilevel-platform-services/data/prediction-store.json"
PREDICTION_INTERVAL_MINUTES=60
PREDICTION_TARGETS="auto"
PREDICTION_STATIONS="OS1BIOS,OS2BIOS,SOLAXBIOS"
PREDICTION_INIT_MODE="resume"
PREDICTION_BACKFILL_HOURS=72
PREDICTION_EXPECTED_SAMPLE_MINUTES=10
PREDICTION_MIN_SAMPLES=6
PREDICTION_STALE_AFTER_MINUTES=30
PREDICTION_MISSING_RATIO_WARN=0.3
SLA_TARGET_PERCENT=95
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_STALE_AFTER_MINUTES=60
NOTIFICATION_REPEAT_AFTER_MINUTES=240
WEATHER_API_BASE=""
WEATHER_API_KEY=""

# BIOS Multi-level Platform - Blockchain Integration Service
BLOCKCHAIN_PORT=8092
BLOCKCHAIN_DB_PATH="bios-multilevel-platform-services/data/blockchain-store.json"
BLOCKCHAIN_EVENT_FILTERS="data_batch_seen,data_quality_changed,prediction_generated,anomaly_detected,sla_breached,sla_recovered,export_file_refreshed,ok,alarm,export,config,critical_measurement"
BLOCKCHAIN_MAX_RETRIES=3
BLOCKCHAIN_WALLET_SEED_FILE=""
BLOCKCHAIN_INIT_MODE="resume"
BLOCKCHAIN_INTERVAL_SECONDS=10
BLOCKCHAIN_RECONFIRM_SECONDS=20
BLOCKCHAIN_EVENT_SOURCE="prediction"
BLOCKCHAIN_EVENT_SCHEMA="v2"
BLOCKCHAIN_ANCHOR_PREDICTIONS=false
BLOCKCHAIN_DEMO_DEVICES="0x0A1C"
BLOCKCHAIN_MAX_BROADCASTS_PER_CYCLE=3
BLOCKCHAIN_SHOW_VENDOR_WARNINGS=false
BLOCKCHAIN_AMQP_MODE="off"
BLOCKCHAIN_INPUT_HOST="amqp://localhost"
BLOCKCHAIN_INPUT_QUEUE="critical-events"
BLOCKCHAIN_OUTPUT_QUEUE="map-events"
STEALTH_RELAY_MODE="mock"
STEALTH_RPC_URL=""
STEALTH_RPC_ID=666420
STEALTH_RPC_USERNAME=""
STEALTH_RPC_PASSWORD=""
STEALTH_API_KEY=""
STEALTH_RPC_STATUS_METHOD="getinfo"
STEALTH_RPC_BALANCE_METHOD="getaddressbalance"
STEALTH_RPC_OUTPUTS_METHOD="getaddressoutputs"
STEALTH_RPC_TX_METHOD="gettransaction"
STEALTH_RPC_BLOCK_METHOD="getblock"
STEALTH_RPC_BEST_BLOCK_METHOD="getbestblock"
STEALTH_RPC_SEND_METHOD="sendrawtransaction"
STEALTH_WIF_FILE=""
STEALTH_WALLET_SEED_FILE=""
STEALTH_RAW_TX_BUILDER_URL=""
STEALTH_ENABLE_REAL_BROADCAST=false
STEALTH_FEEWORK_TIMEOUT_SECONDS=120

# BIOS Multi-level Platform - Deno services dashboard
PREDICTION_SERVICE_URL="http://localhost:8091"
BLOCKCHAIN_SERVICE_URL="http://localhost:8092"
DASHBOARD_EVENT_POLL_SECONDS=2
